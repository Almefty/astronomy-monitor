{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "astronomy-monitor",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  // Static frontend (built by Vite) is served from Cloudflare's asset store for free;
  // only /api/* requests run the Worker.
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true },
  // Workers Cache (free plan, works on workers.dev): enabled for the `Api` entrypoint only, so
  // cache hits never run the Worker or call NASA/NOAA/STScI. The default entrypoint (the front
  // door in worker/index.ts) stays uncached so static asset requests remain free and unlimited
  // (with caching on the default entrypoint, every asset request would be billed as a request).
  // Lifetimes come from each response's Cache-Control (worker/api.ts, `maxAge` per source).
  "cache": { "enabled": true },
  "exports": {
    "default": { "type": "worker", "cache": { "enabled": false } },
    "Api": { "type": "worker", "cache": { "enabled": true } }
  },
  // Generous per-client limit on /api/* (see worker/lib/ratelimit.ts). namespace_id is just a
  // number unique within the Cloudflare account; no dashboard setup needed.
  "ratelimits": [{ "name": "API_RATE_LIMIT", "namespace_id": "1001", "simple": { "limit": 120, "period": 60 } }],
  // Non-secret configuration. The NASA key is NOT here: it is a Worker secret
  // (NASA_API_KEY) set in the Cloudflare dashboard, and in .dev.vars locally.
  "vars": { "APP_ENV": "production" }
}
